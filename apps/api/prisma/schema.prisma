generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(OWNER)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Project {
  id              String              @id @default(cuid())
  title           String
  slug            String              @unique
  summary         String              @db.Text
  description     String              @default("")
  liveUrl         String              @default("")
  sourceUrl       String              @default("")
  frontendRepoUrl String              @default("")
  backendRepoUrl  String              @default("")
  coverImage      String              @default("")
  status          ProjectStatus       @default(DRAFT)
  featured        Boolean             @default(false)
  featuredOrder   Int                 @default(0)
  publishedAt     DateTime?
  categories      ProjectCategory[]
  technologies    ProjectTechnology[]
  images          ProjectImage[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, featured, featuredOrder])
  @@index([updatedAt])
}

model Category {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  projects  ProjectCategory[]
  createdAt DateTime          @default(now())
}

model ProjectCategory {
  projectId  String
  categoryId String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
}

model Technology {
  id         String              @id @default(cuid())
  name       String              @unique
  slug       String              @unique
  category   String
  logoUrl    String              @default("")
  websiteUrl String              @default("")
  visible    Boolean             @default(true)
  sortOrder  Int                 @default(0)
  projects   ProjectTechnology[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([visible, sortOrder])
}

model ProjectTechnology {
  projectId    String
  technologyId String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  altText   String  @default("")
  sortOrder Int     @default(0)
}

model HomepageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  visible   Boolean  @default(true)
  sortOrder Int
  settings  Json     @default("{}")
  updatedAt DateTime @updatedAt
}

model Profile {
  id               String   @id @default("owner")
  name             String   @default("Your Name")
  headline         String   @default("Software Engineer")
  tagline          String   @default("Full Stack Developer · Building thoughtful digital products")
  bio              String   @default("")
  aboutHeading     String   @default("A little about me")
  portraitUrl      String   @default("")
  location         String   @default("")
  email            String   @default("mehrajhasanriajcse@gmail.com")
  linkedinUrl      String   @default("")
  whatsappUrl      String   @default("")
  availableForWork Boolean  @default(true)
  resumeUrl        String   @default("")
  updatedAt        DateTime @updatedAt
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  role        String
  location    String    @default("")
  description String    @default("")
  startDate   DateTime
  endDate     DateTime?
  current     Boolean   @default(false)
  sortOrder   Int       @default(0)
}

model Education {
  id          String    @id @default(cuid())
  institution String
  degree      String
  field       String    @default("")
  description String    @default("")
  startDate   DateTime
  endDate     DateTime?
  sortOrder   Int       @default(0)
}

model Achievement {
  id             String   @id @default(cuid())
  title          String
  issuer         String
  description    String   @default("")
  issueDate      DateTime?
  credentialId   String   @default("")
  credentialUrl  String   @default("")
  certificateUrl String   @default("")
  sortOrder      Int      @default(0)
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([visible, sortOrder])
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String  @default("")
  sortOrder   Int     @default(0)
  visible     Boolean @default(true)
}

model SocialLink {
  id        String  @id @default(cuid())
  label     String
  url       String
  visible   Boolean @default(true)
  sortOrder Int     @default(0)
}

model SiteSettings {
  id          String   @id @default("site")
  siteTitle   String   @default("Portfolio")
  description String   @default("")
  accentColor String   @default("#146c5b")
  theme       String   @default("light")
  updatedAt   DateTime @updatedAt
}

model SeoSettings {
  id          String @id @default("seo")
  title       String @default("Portfolio")
  description String @default("")
  imageUrl    String @default("")
  faviconUrl  String @default("")
}

model Media {
  id          String   @id @default(cuid())
  url         String
  provider    String   @default("external")
  providerKey String   @default("")
  mimeType    String   @default("")
  sizeBytes   Int      @default(0)
  altText     String   @default("")
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String        @default("")
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())
  readAt    DateTime?

  @@index([status, createdAt])
}
